# --- Required ---
# Which LLM provider to use: anthropic | openai | gemini
LLM_PROVIDER=anthropic

# API key for the chosen provider. Only the one matching LLM_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model name for the chosen provider
LLM_MODEL=claude-sonnet-5

# --- Optional tuning ---
LLM_MAX_TOKENS=1500
CRITIC_APPROVAL_THRESHOLD=8.0
MAX_PLANNER_RETRIES=2
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
# Create the "agent_sandbox" database yourself first (e.g. via pgAdmin4's "Create > Database"
# dialog, or `CREATE DATABASE agent_sandbox;` in its Query Tool). Tables are created
# automatically on backend startup - open pgAdmin4 afterwards to inspect the demo_sessions table.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agent_sandbox

# --- Company portal auth ---
# Set a real, unique secret outside local development - signs company-portal JWTs.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=1440

# First COMPANY_ADMIN account, seeded once on startup only if the users table is empty.
SEED_ADMIN_EMAIL=admin@winfomi.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Not wired in MVP (stretch goals only) ---
SLACK_TOKEN=
EMAIL_SERVICE_API_KEY=
CRM_API_KEY=
